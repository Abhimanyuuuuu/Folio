{
	"name": "www",
	"compatibility_date": "2025-09-02",
	"main": "worker/index.js",
	"assets": {
		"directory": "build",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"kv_namespaces": [
		{
			"binding": "INSPO_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	"triggers": {
		"crons": ["0 9 * * *"]
	},
	"vars": {
		"INSPO_COLLECTIONS": "web design, visual art",
		"GITHUB_USERNAME": "Abhimanyuuuuu"
	}
	// CONVEX_URL is a secret: `wrangler secret put CONVEX_URL` (and .dev.vars locally)
}
